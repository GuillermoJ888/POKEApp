<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Toda la app va en vertical: al girar el teléfono no se recrea la pantalla ni se pierde lo elegido -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.POKEApp">

        <!-- Splash = pantalla de inicio -->
        <activity
            android:name=".SplashActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity"
            android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".RegisterActivity"
            android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".MenuActivity"
            android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".PokedexActivity"
            android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".FavoritosActivity"
            android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".PerfilActivity"
            android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".BattleEmulatorActivity"
            android:screenOrientation="portrait" android:exported="false" />
        <activity
            android:name=".BattleArenaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".HistorialActivity"
            android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".VersusActivity"
            android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".ElegirPokemonActivity"
            android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".TorreActivity"
            android:screenOrientation="portrait" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>