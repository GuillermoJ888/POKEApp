<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo oscuro con neblina donde se levanta la Torre -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#070706" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="260dp" android:centerX="0.5" android:centerY="0.45"
                android:startColor="#3A3D33" android:endColor="#00070706" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1.5dp" android:color="#7A5A24" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
