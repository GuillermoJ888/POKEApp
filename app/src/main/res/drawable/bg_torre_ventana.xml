<?xml version="1.0" encoding="utf-8"?>
<!-- Ventana iluminada del piso, donde se asoma el docente -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#E2C27A" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <gradient android:type="radial" android:gradientRadius="34dp"
                android:startColor="#6B5A3A" android:endColor="#17120B" />
            <stroke android:width="1dp" android:color="#3A2A14" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
