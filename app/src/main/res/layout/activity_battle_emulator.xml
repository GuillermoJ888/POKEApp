<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_menu_header"
            android:clipChildren="true">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="-40dp"
                android:layout_marginBottom="-28dp"
                android:alpha="0.14"
                android:src="@drawable/ic_pokeball_watermark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="46dp"
                android:paddingBottom="26dp">

                <TextView
                    android:id="@+id/btnRegresar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_boton_regresar"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:contentDescription="@string/t_regresar" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/t_battle_emulator_2"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHistorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_button_outline"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/t_historial"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Pokémon A ya aceptado -->
            <LinearLayout
                android:id="@+id/cardElegidoA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_menu"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgElegidoA"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/t_pokemon_a_2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t_pokemon_a"
                        android:textColor="?attr/pkTextoSuave"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvNombreElegidoA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t_nombre_2"
                        android:textColor="?attr/pkTexto"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTiposElegidoA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t_tipo"
                        android:textColor="?attr/pkTextoSuave"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnCambiarA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/t_cambiar"
                    android:textColor="@color/menu_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- "VS" entre las dos tarjetas (solo con A y B listos) -->
            <TextView
                android:id="@+id/tvVsListos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:text="@string/t_vs"
                android:textColor="@color/menu_red"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Pokémon B ya aceptado -->
            <LinearLayout
                android:id="@+id/cardElegidoB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_menu"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgElegidoB"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/t_pokemon_b_2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t_pokemon_b"
                        android:textColor="?attr/pkTextoSuave"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvNombreElegidoB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t_nombre_2"
                        android:textColor="?attr/pkTexto"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTiposElegidoB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t_tipo"
                        android:textColor="?attr/pkTextoSuave"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnCambiarB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/t_cambiar"
                    android:textColor="@color/menu_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.example.pokeapp.PokeBoton
                android:id="@+id/btnIniciarBatalla"
                app:tema="charizard"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="40dp"
                android:text="@string/t_iniciar_batalla"
                android:textColor="@color/poke_blue_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- ===== Buscador (paso A y paso B) ===== -->
            <LinearLayout
                android:id="@+id/seccionBuscador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPaso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/t_paso_1_de_2_elige_al_pokemon_a"
                    android:textColor="?attr/pkTexto"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etBuscar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dex_search"
                        android:hint="@string/t_nombre_o_numero"
                        android:textColorHint="#8A8A8A"
                        android:textColor="#14213D"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true" />

                    <com.example.pokeapp.PokeBoton
                        android:id="@+id/btnBuscar"
                        app:tema="pikachu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/t_buscar"
                        android:textColor="@color/poke_blue_dark"
                        android:textStyle="bold"
                        android:paddingLeft="18dp"
                        android:paddingRight="18dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSugerencias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dex_suggestions"
                    android:overScrollMode="never"
                    android:visibility="gone" />

                <com.example.pokeapp.PokeBoton
                    android:id="@+id/btnSorprendeme"
                    app:tema="ditto"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="26dp"
                    android:text="@string/t_sorprendeme"
                    android:textColor="@color/menu_red"
                    android:textStyle="bold" />

                <!-- Populares: visibles mientras el buscador está vacío -->
                <LinearLayout
                    android:id="@+id/seccionPopulares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/t_populares_toca_uno_para_elegirlo"
                        android:textColor="?attr/pkTextoSuave"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPopulares"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressSeleccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMensajeSeleccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/menu_red"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Vista previa del Pokémon encontrado -->
                <LinearLayout
                    android:id="@+id/cardPrevia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_card_menu"
                    android:padding="18dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnCerrarPrevia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:background="@drawable/bg_modulo_etiqueta"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/t_ver_otros"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgPrevia"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/t_pokemon_encontrado" />

                    <TextView
                        android:id="@+id/tvNombrePrevia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/t_n_000_nombre"
                        android:textColor="?attr/pkTexto"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTiposPrevia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/t_tipo"
                        android:textColor="?attr/pkTextoSuave"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvStatsPrevia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text=""
                        android:textColor="?attr/pkTexto"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <com.example.pokeapp.PokeBoton
                        android:id="@+id/btnAceptar"
                        app:tema="eevee"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="30dp"
                        android:text="@string/t_aceptar"
                        android:textColor="@color/poke_blue_dark"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
