<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_pokeball_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="PokéApp V2"
            android:textColor="@color/poke_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="28dp"
            android:text="Inicia sesión para continuar"
            android:textColor="@color/poke_gray_text"
            android:textSize="13sp" />

        <!-- Correo -->
        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field_rounded"
            android:hint="Correo electrónico"
            android:textColorHint="@color/poke_gray_text"
            android:textColor="@color/poke_white"
            android:inputType="textEmailAddress"
            android:drawablePadding="10dp" />

        <!-- Contraseña -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field_rounded"
                android:hint="Contraseña"
                android:textColorHint="@color/poke_gray_text"
                android:textColor="@color/poke_white"
                android:inputType="textPassword"
                android:paddingEnd="48dp" />

            <ImageButton
                android:id="@+id/btnMostrarContrasena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/poke_gray_text"
                android:contentDescription="Mostrar u ocultar contraseña" />
        </RelativeLayout>

        <!-- Recordarme + Olvidé contraseña -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cbRecordarme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recordarme"
                android:textColor="@color/poke_gray_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOlvideContrasena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="@color/poke_gold"
                android:textSize="12sp"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Botón iniciar sesión -->
        <com.example.pokeapp.PokeBoton
            android:id="@+id/btnIniciarSesion"
            app:tema="charmander"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="INICIAR SESIÓN"
            android:textColor="@color/poke_blue_dark"
            android:textStyle="bold"
            android:elevation="2dp" />

        <ProgressBar
            android:id="@+id/progressLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Separador "o" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="22dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#33FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  o  "
                android:textColor="@color/poke_gray_text" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#33FFFFFF" />
        </LinearLayout>

        <!-- Continuar con Google -->
        <com.example.pokeapp.PokeBoton
            android:id="@+id/btnGoogle"
            app:tema="squirtle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="34dp"
            android:text="Continuar con Google"
            android:textColor="@color/poke_white"
            android:drawableStart="@android:drawable/ic_secure"
            android:drawablePadding="10dp" />

        <!-- Crear cuenta -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿No tienes cuenta? "
                android:textColor="@color/poke_gray_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCrearCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear una cuenta"
                android:textColor="@color/poke_gold"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
