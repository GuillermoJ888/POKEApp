<?xml version="1.0" encoding="utf-8"?>
<!-- Maestro de Tipos (módulo G): marcador, reloj, Pokémon rival y 4 opciones de tipo -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_menu_header"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="46dp"
            android:paddingBottom="26dp">

            <TextView
                android:id="@+id/btnRegresar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_boton_regresar"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:contentDescription="@string/t_regresar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t_maestro_de_tipos_2"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecordTipos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t_record_0"
                    android:textColor="#FFD9D2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Marcador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPuntosTipos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⭐ 0"
                    android:textColor="?attr/pkTexto"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNivelTipos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:text="@string/t_nivel_1"
                    android:textColor="@color/menu_red"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVidasTipos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/barraTiempoTipos"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/menu_red" />

            <!-- Pokémon rival -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card_menu"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imgTipos"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pokeball_logo"
                    android:contentDescription="@string/t_pokemon_rival" />

                <TextView
                    android:id="@+id/tvNombreTipos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/t_maestro_de_tipos"
                    android:textColor="?attr/pkTexto"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTiposRival"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t_ventajas_y_desventajas"
                    android:textColor="?attr/pkTextoSuave"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPreguntaTipos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:minLines="2"
                android:text="@string/t_toca_el_tipo_de_ataque_super_efica"
                android:textColor="?attr/pkTexto"
                android:textSize="15sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/gridOpcionesTipos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2" />

            <com.example.pokeapp.PokeBoton
                android:id="@+id/btnJugarTipos"
                app:tema="charizard"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="40dp"
                android:text="@string/t_jugar"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
