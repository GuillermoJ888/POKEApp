<?xml version="1.0" encoding="utf-8"?>
<!-- Sala de la batalla entre dispositivos: armar equipo, crear/buscar sala y revancha -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollMultijugador"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_menu_header"
            android:clipChildren="true">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="-40dp"
                android:layout_marginBottom="-28dp"
                android:alpha="0.14"
                android:src="@drawable/ic_pokeball_watermark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="46dp"
                android:paddingBottom="26dp">

                <TextView
                    android:id="@+id/btnRegresar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_boton_regresar"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:contentDescription="Regresar" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="📡 Entre dispositivos"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHistorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_button_outline"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="📜 Historial"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dos celulares cercanos, cada quien con su equipo de 3 Pokémon. Uno crea la sala y el otro la busca; no hace falta internet para conectarse."
                android:textColor="@color/menu_text_soft"
                android:textSize="13sp" />

            <!-- Mi equipo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_menu"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvTituloMiEquipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 Tu equipo · 0/3"
                    android:textColor="@color/menu_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/slotsMiEquipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Conexión -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_menu"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📶 Conexión"
                    android:textColor="@color/menu_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEstadoRed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="@color/menu_text_soft"
                    android:textSize="13sp" />

                <!-- Salas encontradas (se llenan desde el código) -->
                <LinearLayout
                    android:id="@+id/listaSalas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <com.example.pokeapp.PokeBoton
                android:id="@+id/btnCrearSala"
                app:tema="charizard"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="40dp"
                android:text="📡 Crear sala"
                android:textSize="17sp" />

            <com.example.pokeapp.PokeBoton
                android:id="@+id/btnBuscarSala"
                app:tema="squirtle"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="40dp"
                android:text="🔍 Buscar sala"
                android:textSize="17sp" />

            <com.example.pokeapp.PokeBoton
                android:id="@+id/btnRevanchaRed"
                app:tema="pikachu"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="40dp"
                android:text="⚔️ Revancha"
                android:textSize="17sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnCancelarRed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:text="Cancelar"
                android:textColor="@color/menu_red"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
