<?xml version="1.0" encoding="utf-8"?>
<!-- ¿Quién es ese Pokémon? (módulo E): marcador, silueta, pistas y 4 nombres -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_menu_header"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="46dp"
            android:paddingBottom="26dp">

            <TextView
                android:id="@+id/btnRegresar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_boton_regresar"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:contentDescription="@string/t_regresar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t_quien_es_ese_pokemon"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecordQuien"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t_record_0"
                    android:textColor="#FFD9D2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Marcador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPuntosQuien"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⭐ 0"
                    android:textColor="@color/menu_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRachaQuien"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:text="@string/t_racha_0"
                    android:textColor="@color/menu_red"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVidasQuien"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Silueta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card_menu"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imgQuien"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pokeball_logo"
                    android:contentDescription="@string/t_silueta_del_pokemon" />

                <TextView
                    android:id="@+id/tvPistasQuien"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/menu_text_soft"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPreguntaQuien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:minLines="2"
                android:text="@string/t_adivina_el_pokemon_por_su_silueta_"
                android:textColor="@color/menu_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Pistas opcionales -->
            <LinearLayout
                android:id="@+id/filaPistasQuien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnPistaTipo"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_boton_cambiar"
                    android:text="@string/t_tipo"
                    android:textColor="#142036"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPistaStats"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_boton_cambiar"
                    android:text="@string/t_stats"
                    android:textColor="#142036"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPistaCry"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_boton_cambiar"
                    android:text="@string/t_cry"
                    android:textColor="#142036"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/gridOpcionesQuien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:columnCount="2" />

            <com.example.pokeapp.PokeBoton
                android:id="@+id/btnJugarQuien"
                app:tema="gengar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="40dp"
                android:text="@string/t_jugar"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
