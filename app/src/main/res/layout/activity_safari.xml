<?xml version="1.0" encoding="utf-8"?>
<!-- Safari Pokémon (módulo F) a pantalla completa: el bosque cubre todo y encima van
     la barra, los datos del Pokémon, la zona de lanzamiento y las Pokéball -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2F6B3A">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_escenario_bosque"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="28dp"
        android:paddingBottom="18dp">

        <!-- Barra: regresar, título con la colección y ver colección -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_safari_panel"
            android:padding="8dp">

            <TextView
                android:id="@+id/btnRegresar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_boton_regresar"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:contentDescription="@string/t_regresar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t_safari_pokemon"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/fredoka"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvColeccionSafari"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t_coleccion_0"
                    android:textColor="#D9F7C8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnVerColeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:gravity="center"
                android:background="@drawable/bg_button_outline"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/t_ver"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nombre y datos del Pokémon salvaje -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_safari_panel"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvNombreSafari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="…"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/fredoka"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDatosSafari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textColor="#E8F5E0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Zona del encuentro (toda la parte libre de la pantalla): el Pokémon al centro
             y abajo la bola que se desliza con el dedo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true">

            <ImageView
                android:id="@+id/imgSafari"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:layout_marginBottom="70dp"
                android:scaleType="fitCenter"
                android:visibility="invisible"
                android:contentDescription="@string/t_pokemon_salvaje" />

            <com.example.pokeapp.AroCaptura
                android:id="@+id/aroSafari"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:layout_marginBottom="70dp"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/imgBolaSafari"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:src="@drawable/ic_pokeball_logo"
                android:visibility="invisible"
                android:contentDescription="@string/t_pokeball" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvMensajeSafari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minLines="2"
            android:background="@drawable/bg_safari_panel"
            android:padding="10dp"
            android:text="@string/t_algo_se_mueve_entre_la_hierba"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Pokéball: tocar para elegirla (tocar otra vez la lanza recta); cuántas quedan y su probabilidad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBola0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:gravity="center"
                android:background="@drawable/bg_boton_cambiar"
                android:text="@string/t_poke_ball"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBola1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:gravity="center"
                android:background="@drawable/bg_boton_cambiar"
                android:text="@string/t_super_ball"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBola2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:gravity="center"
                android:background="@drawable/bg_boton_cambiar"
                android:text="@string/t_ultra_ball"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnHuirSafari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:minHeight="44dp"
                android:gravity="center"
                android:background="@drawable/bg_safari_panel"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/t_huir_del_encuentro"
                android:textColor="#FFD9D2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.example.pokeapp.PokeBoton
                android:id="@+id/btnNuevoSafari"
                app:tema="bulbasaur"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:text="@string/t_nuevo_safari"
                android:textSize="17sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
