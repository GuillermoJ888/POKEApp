<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollTorre"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera (se oculta en la pantalla de la torre, que trae sus propios botones) -->
        <FrameLayout
            android:id="@+id/cabeceraTorre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_menu_header"
            android:clipChildren="true">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="-30dp"
                android:layout_marginBottom="-30dp"
                android:alpha="0.22"
                android:src="@drawable/ic_torre_pisa" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="46dp"
                android:paddingBottom="26dp">

                <TextView
                    android:id="@+id/btnRegresar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_boton_regresar"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:contentDescription="@string/t_regresar" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/t_torre_pokemon"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/fredoka"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHistorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_button_outline"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/t_historial"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/contenidoTorre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ===== INICIO: escalera de 6 niveles ===== -->
            <LinearLayout
                android:id="@+id/seccionInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Barra propia de la torre: regresar, título e historial -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/btnRegresarTorre"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="←"
                        android:textColor="#E8D08A"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:contentDescription="@string/t_regresar" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_torre_titulo"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.2"
                        android:maxLines="1"
                        android:text="TORRE POKÉMON"
                        android:textColor="#E8D08A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnHistorialTorre"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="📜"
                        android:textSize="22sp"
                        android:contentDescription="@string/t_historial" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMedallasTorre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/t_medallas_0_10"
                    android:textColor="#C9A45C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- La torre: un piso por nivel (se arma en TorreActivity.pintarEscalera) -->
                <LinearLayout
                    android:id="@+id/listaNiveles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ===== ELECCIÓN: 3 de 6 Pokémon al azar ===== -->
            <LinearLayout
                android:id="@+id/seccionEleccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t_elige_3_pokemon_para_tu_equipo"
                    android:textColor="?attr/pkTexto"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvElegidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/t_elegidos_0_3"
                    android:textColor="@color/menu_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressEleccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="30dp" />

                <GridLayout
                    android:id="@+id/gridOpciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:columnCount="3" />

                <com.example.pokeapp.PokeBoton
                    android:id="@+id/btnConfirmarEquipo"
                    app:tema="eevee"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="40dp"
                    android:text="@string/t_confirmar_equipo" />
            </LinearLayout>

            <!-- ===== NIVEL: docente, rivales y tu equipo ===== -->
            <LinearLayout
                android:id="@+id/seccionNivel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_card_menu"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvNivelActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t_nivel_1_de_6"
                        android:textColor="@color/menu_red"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <ImageView
                        android:id="@+id/imgDocente"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_avatar_perfil"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_docente_silueta"
                        android:contentDescription="@string/t_docente_del_nivel" />

                    <TextView
                        android:id="@+id/tvDocente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/t_docente_cesba_1"
                        android:textColor="?attr/pkTexto"
                        android:fontFamily="@font/fredoka"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEscenarioNivel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t_bosque"
                        android:textColor="?attr/pkTextoSuave"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/t_su_equipo"
                        android:textColor="?attr/pkTextoSuave"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <ProgressBar
                        android:id="@+id/progressRivales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:id="@+id/filaRivales"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/t_tu_equipo_se_cura_al_empezar_cada_"
                        android:textColor="?attr/pkTextoSuave"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <LinearLayout
                        android:id="@+id/filaTuEquipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMensajeNivel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/menu_red"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <com.example.pokeapp.PokeBoton
                    android:id="@+id/btnPelearNivel"
                    app:tema="charizard"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="44dp"
                    android:text="@string/t_pelear"
                    android:textSize="17sp" />

                <com.example.pokeapp.PokeBoton
                    android:id="@+id/btnAbandonar"
                    app:tema="gengar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="34dp"
                    android:text="@string/t_abandonar_campana" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
