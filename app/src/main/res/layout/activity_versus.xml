<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollVersus"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_menu_header"
            android:clipChildren="true">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="-40dp"
                android:layout_marginBottom="-28dp"
                android:alpha="0.14"
                android:src="@drawable/ic_pokeball_watermark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="46dp"
                android:paddingBottom="26dp">

                <TextView
                    android:id="@+id/btnRegresar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="🆚 Battle Versus"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHistorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_button_outline"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="📜 Historial"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dos jugadores en el mismo celular: cada uno arma un equipo de 3 Pokémon y se turnan para atacar."
                android:textColor="@color/menu_text_soft"
                android:textSize="13sp" />

            <!-- Equipo del Jugador 1 -->
            <LinearLayout
                android:id="@+id/cardJugador1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_menu"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvTituloJugador1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 Jugador 1 · 0/3"
                    android:textColor="@color/menu_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/slotsJugador1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Equipo del Jugador 2 -->
            <LinearLayout
                android:id="@+id/cardJugador2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_menu"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvTituloJugador2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵 Jugador 2 · 0/3"
                    android:textColor="@color/menu_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/slotsJugador2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPasoVersus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Toca un + para agregar un Pokémon"
                android:textColor="@color/menu_red"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.example.pokeapp.PokeBoton
                android:id="@+id/btnIniciarVersus"
                app:tema="charizard"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="44dp"
                android:text="⚔️ ¡A pelear!"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
