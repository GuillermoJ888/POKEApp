<?xml version="1.0" encoding="utf-8"?>
<!-- Ventana para elegir avatar (se llena desde PerfilActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_dialogo_perfil"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Elige tu avatar"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Se guarda solo en este celular"
        android:textColor="@color/perfil_text_soft"
        android:textSize="12sp" />

    <GridLayout
        android:id="@+id/gridAvatares"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:columnCount="3" />
</LinearLayout>
