<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de una batalla del Historial: encabezado + tarjetas por turno -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_menu"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgDetalleA"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter"
            android:contentDescription="Pokémon A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDetalleVs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="A vs B"
                android:textColor="@color/menu_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleGanador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🏆 Ganó A · 5 turnos"
                android:textColor="@color/menu_red"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha"
                android:textColor="@color/menu_text_soft"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgDetalleB"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter"
            android:contentDescription="Pokémon B" />
    </LinearLayout>

    <!-- Toda la batalla narrada en un solo párrafo -->
    <ScrollView
        android:id="@+id/scrollNarracion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dex_panel"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:scrollbarThumbVertical="@drawable/bg_scroll_thumb"
        android:scrollbarSize="4dp"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="28dp">

        <TextView
            android:id="@+id/tvNarracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#E6ECFA"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp" />
    </ScrollView>

    <Button
        android:id="@+id/btnCerrarDetalle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_primary"
        android:text="Cerrar"
        android:textAllCaps="false"
        android:textColor="@color/poke_blue_dark"
        android:textStyle="bold" />
</LinearLayout>
