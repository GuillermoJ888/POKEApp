<?xml version="1.0" encoding="utf-8"?>
<!-- Ventana "elige tu siguiente Pokémon" / "cambiar Pokémon" dentro de la batalla -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialogo_batalla"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvDuenoDialogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JUGADOR 2"
        android:textColor="#FACC15"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvTituloDialogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Elige tu siguiente Pokémon"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/listaEquipoDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/btnCancelarDialogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        android:minHeight="40dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Cancelar"
        android:textColor="#C9D1E8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
