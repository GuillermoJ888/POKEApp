<?xml version="1.0" encoding="utf-8"?>
<!-- Ventana emergente con el ganador, encima del Emulator -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_card_menu"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/t_ganador"
        android:textColor="@color/menu_red"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <FrameLayout
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginTop="8dp">

        <View
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal|bottom"
            android:background="@drawable/bg_battle_platform" />

        <ImageView
            android:id="@+id/imgGanador"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal|top"
            android:scaleType="fitCenter"
            android:contentDescription="@string/t_pokemon_ganador" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvGanador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/t_nombre_2"
        android:textColor="?attr/pkTexto"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvContra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/t_vencio_a"
        android:textColor="?attr/pkTextoSuave"
        android:textSize="13sp" />

    <!-- HP restante y turnos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_chip_turnos"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvHpGanador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0"
                android:textColor="?attr/pkTexto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/t_hp_restante"
                android:textColor="?attr/pkTextoSuave"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_chip_turnos"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvTurnosGanador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/pkTexto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/t_numero_de_turnos"
                android:textColor="?attr/pkTextoSuave"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <com.example.pokeapp.PokeBoton
        android:id="@+id/btnRevancha"
        app:tema="jigglypuff"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:text="@string/t_revancha_2"
        android:textColor="@color/poke_blue_dark"
        android:textStyle="bold" />

    <com.example.pokeapp.PokeBoton
        android:id="@+id/btnElegirOtro"
        app:tema="psyduck"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="@string/t_elegir_otro_pokemon"
        android:textColor="@color/poke_blue_dark"
        android:textStyle="bold" />

    <com.example.pokeapp.PokeBoton
        android:id="@+id/btnMenu"
        app:tema="snorlax"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="@string/t_regresar_al_menu"
        android:textColor="@color/menu_red"
        android:textStyle="bold" />
</LinearLayout>
