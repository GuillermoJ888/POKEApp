<?xml version="1.0" encoding="utf-8"?>
<!-- Ventana de resultado de la Torre: nivel superado, derrota o medalla -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_card_menu"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvEmojiResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏆"
        android:textSize="52sp" />

    <TextView
        android:id="@+id/tvTituloResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="¡Nivel superado!"
        android:textColor="@color/menu_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMensajeResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/menu_text_soft"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <com.example.pokeapp.PokeBoton
        android:id="@+id/btnPrincipalResultado"
        app:tema="charizard"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="40dp"
        android:text="Siguiente nivel" />

    <com.example.pokeapp.PokeBoton
        android:id="@+id/btnSecundarioResultado"
        app:tema="snorlax"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="Salir" />
</LinearLayout>
