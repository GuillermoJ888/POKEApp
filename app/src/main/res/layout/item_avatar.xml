<?xml version="1.0" encoding="utf-8"?>
<!-- Una opción dentro de la ventana "Elige tu avatar" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="6dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackgroundBorderless">

    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp">

        <ImageView
            android:id="@+id/imgOpcionAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar_perfil"
            android:scaleType="centerCrop"
            android:contentDescription="Avatar" />

        <!-- Marca del avatar elegido -->
        <TextView
            android:id="@+id/tvOpcionElegida"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="end|bottom"
            android:background="@drawable/bg_avatar_marca"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvOpcionNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Avatar"
        android:textColor="@color/perfil_lavender"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
