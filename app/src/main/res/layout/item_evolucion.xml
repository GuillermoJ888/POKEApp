<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nodoEvolucion"
    android:layout_width="92dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/bg_mini_normal">

    <ImageView
        android:id="@+id/imgEvolucion"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="fitCenter"
        android:contentDescription="Pokémon de la línea evolutiva" />

    <TextView
        android:id="@+id/tvNumeroEvolucion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#001"
        android:textColor="#7A1507"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNombreEvolucion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Nombre"
        android:textColor="#14213D"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
