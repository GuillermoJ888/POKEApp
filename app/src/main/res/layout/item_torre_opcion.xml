<?xml version="1.0" encoding="utf-8"?>
<!-- Uno de los 6 Pokémon al azar que se ofrecen al empezar la Torre -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tarjetaOpcion"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_margin="5dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_mini_normal"
    android:padding="8dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="78dp"
        android:layout_height="78dp">

        <ImageView
            android:id="@+id/imgOpcion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Pokémon" />

        <TextView
            android:id="@+id/tvMarcaOpcion"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|top"
            android:background="@drawable/bg_avatar_marca"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvNombreOpcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Nombre"
        android:textColor="#14213D"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTiposOpcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Tipo"
        android:textColor="#7A1507"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tvStatsOpcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="HP 0 · ATK 0"
        android:textColor="#5B6478"
        android:textSize="9sp" />
</LinearLayout>
