<?xml version="1.0" encoding="utf-8"?>
<!--
  Selector de Pokémon reutilizable (lo controla SelectorPokemon.java):
  buscador con sugerencias, 🎲 al azar, populares y vista previa con botón Aceptar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/selectorPokemon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etBuscarSel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_dex_search"
            android:hint="Nombre o número..."
            android:textColorHint="#8A8A8A"
            android:textColor="#14213D"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true" />

        <com.example.pokeapp.PokeBoton
            android:id="@+id/btnBuscarSel"
            app:tema="pikachu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="18dp"
            android:text="Buscar" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSugerenciasSel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_dex_suggestions"
        android:overScrollMode="never"
        android:visibility="gone" />

    <com.example.pokeapp.PokeBoton
        android:id="@+id/btnSorprendemeSel"
        app:tema="ditto"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="26dp"
        android:text="🎲 Sorpréndeme" />

    <LinearLayout
        android:id="@+id/seccionPopularesSel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⭐ POPULARES · toca uno para elegirlo"
            android:textColor="@color/menu_text_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPopularesSel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressSel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMensajeSel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/menu_red"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Vista previa decorada: fondo del color del tipo, plataforma, chips y barras de stats -->
    <LinearLayout
        android:id="@+id/cardPreviaSel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_menu"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/fondoTipoSel"
            android:layout_width="match_parent"
            android:layout_height="210dp">

            <ImageView
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="-40dp"
                android:alpha="0.22"
                android:src="@drawable/ic_pokeball_watermark"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/plataformaSel"
                android:layout_width="170dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/imgPreviaSel"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="22dp"
                android:scaleType="fitCenter"
                android:contentDescription="Pokémon encontrado" />

            <TextView
                android:id="@+id/btnCerrarPreviaSel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_margin="10dp"
                android:minHeight="36dp"
                android:gravity="center"
                android:background="@drawable/bg_modulo_etiqueta"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="✕ Ver otros"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNumeroSel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="12dp"
                android:background="@drawable/bg_modulo_etiqueta"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="#000"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/tvNombrePreviaSel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textColor="@color/menu_text"
                android:textSize="23sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/chipsTiposSel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tvTiposPreviaSel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="STATS DE BATALLA"
                android:textColor="@color/menu_text_soft"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/statsSel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvStatsPreviaSel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text=""
                android:textColor="@color/menu_text_soft"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.example.pokeapp.PokeBoton
                android:id="@+id/btnAceptarSel"
                app:tema="eevee"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="34dp"
                android:text="Aceptar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
