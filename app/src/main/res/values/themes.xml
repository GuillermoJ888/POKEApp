<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.POKEApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.POKEApp" parent="Base.Theme.POKEApp">
        <!-- Los botones usan su propio android:background (sin el morado de Material) -->
        <item name="materialButtonStyle">@style/Widget.POKEApp.Button</item>
        <!-- Toda carga circular es una Pokéball que gira -->
        <item name="android:progressBarStyle">@style/Widget.POKEApp.CargaPokeball</item>
        <!-- Las pantallas entran deslizándose desde la derecha y salen hacia la derecha al regresar -->
        <item name="android:windowAnimationStyle">@style/Animacion.POKEApp</item>

        <!-- Colores del tema claro; en oscuro Android toma los de values-night/colors.xml -->
        <item name="pkFondo">@color/menu_bg</item>
        <item name="pkTexto">@color/menu_text</item>
        <item name="pkTextoSuave">@color/menu_text_soft</item>
        <item name="pkTarjetaFondo">@color/tarjeta_fondo</item>
        <item name="pkTarjetaBorde">@color/tarjeta_borde</item>
        <item name="pkChipFondo">@color/chip_fondo</item>
        <item name="pkVidaFondo">@color/vida_fondo</item>
        <item name="pkVidaBorde">@color/vida_borde</item>
    </style>

    <!-- Tema Pokédex: pantalla verde tipo LCD con el marco rojo de siempre (lo pone PokeApp.java) -->
    <style name="Theme.POKEApp.Pokedex">
        <item name="pkFondo">@color/dex_menu_bg</item>
        <item name="pkTexto">@color/dex_menu_text</item>
        <item name="pkTextoSuave">@color/dex_menu_text_soft</item>
        <item name="pkTarjetaFondo">@color/dex_tarjeta_fondo</item>
        <item name="pkTarjetaBorde">@color/dex_tarjeta_borde</item>
        <item name="pkChipFondo">@color/dex_chip_fondo</item>
        <item name="pkVidaFondo">@color/dex_vida_fondo</item>
        <item name="pkVidaBorde">@color/dex_vida_borde</item>
    </style>

    <style name="Widget.POKEApp.CargaPokeball" parent="@android:style/Widget.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/anim_carga_pokeball</item>
        <item name="android:indeterminateDuration">1500</item>
        <item name="android:indeterminateOnly">true</item>
    </style>

    <style name="Animacion.POKEApp" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/entrar_desde_derecha</item>
        <item name="android:activityOpenExitAnimation">@anim/salir_hacia_izquierda</item>
        <item name="android:activityCloseEnterAnimation">@anim/entrar_desde_izquierda</item>
        <item name="android:activityCloseExitAnimation">@anim/salir_hacia_derecha</item>
    </style>

    <style name="Widget.POKEApp.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
