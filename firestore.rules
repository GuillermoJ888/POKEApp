rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada entrenador solo puede leer y escribir SUS propios datos
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /favoritos/{pokemonId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /historial/{batallaId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
